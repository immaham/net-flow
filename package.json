{
  "name": "net-flow",
  "version": "1.0.0",
  "description": "A custom reverse proxy and smart load balancer built from scratch with Node.js and TypeScript to explore TCP, HTTP, networking, failure handling, load balancing, observability, and production infrastructure.",
  "main": "index.js",
  "scripts": {
    "dev:tcp": "tsx src/tcp-server.ts",
    "dev:http": "tsx src/http-server.ts",
    "dev:backend": "tsx src/servers/backend-server.ts",
    "dev:backend-1": "PORT=9101 INSTANCE_NAME=backend-1 npm run dev:backend",
    "dev:backend-2": "PORT=9102 INSTANCE_NAME=backend-2 npm run dev:backend",
    "dev:backend-3": "PORT=9103 INSTANCE_NAME=backend-3 npm run dev:backend",
    "dev:backend-all": "npm-run-all --parallel dev:backend-1 dev:backend-2 dev:backend-3",
    "dev:websocket": "tsx src/servers/websocket-backend-server.ts",
    "test:websocket": "tsx src/servers/websocket-test-client.ts",
    "dev:proxy": "tsx src/servers/proxy-server.ts",
    "start": "tsx src/tcp-server.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "immaham",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.2",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  }
}
